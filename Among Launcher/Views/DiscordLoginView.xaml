<UserControl x:Class="AmongLauncher.Views.DiscordLoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:web="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             mc:Ignorable="d" d:DesignHeight="600" d:DesignWidth="800"
             Width="460" Height="540" MinWidth="460" MinHeight="540">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" Text="Log in with Discord" 
                   Style="{StaticResource PageTitle}" Margin="0,0,0,10"/>

        <!-- WebView2 browser -->
        <web:WebView2 x:Name="Browser" Grid.Row="1"
                      Width="440" Height="440" MinWidth="440" MinHeight="400"
                      HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>

        <!-- Footer with Cancel button -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <TextBlock x:Name="ErrorText" Text="" Foreground="Red" FontSize="12"
                       VerticalAlignment="Center" Margin="0,0,12,0" Visibility="Collapsed"/>
            <Button x:Name="CancelButton" Content="Cancel" 
                    Style="{StaticResource SecondaryButton}" Width="120" Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</UserControl>
