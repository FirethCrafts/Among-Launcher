<UserControl x:Class="AmongLauncher.Views.LauncherUpdateModal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="420" d:DesignWidth="460">
    <StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
            <Border Background="#22222A" CornerRadius="10" Width="44" Height="44"
                    HorizontalAlignment="Left" VerticalAlignment="Top">
                <TextBlock Text="⬆" FontSize="22" Foreground="#22C55E"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="Update Available" FontSize="15" FontWeight="SemiBold"
                           Foreground="{StaticResource TextTitle}"/>
                <TextBlock Text="Among Launcher" FontSize="12"
                           Foreground="{StaticResource TextMuted}"/>
            </StackPanel>
        </StackPanel>

        <TextBlock x:Name="MessageText" Text="" FontSize="14"
                   Foreground="{StaticResource TextBody}" TextWrapping="Wrap" Margin="0,0,0,12"/>

        <Border x:Name="ChangelogBorder" Background="{StaticResource GlassSurfaceWeak}" CornerRadius="8" Margin="0,0,0,16" Visibility="Collapsed">
            <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto" Padding="16">
                <TextBlock x:Name="ChangelogContent" FontSize="13" Foreground="{StaticResource TextBody}" TextWrapping="Wrap" LineHeight="22" FontFamily="Segoe UI"/>
            </ScrollViewer>
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="CloseButton" Content="Close"
                    Click="CloseButton_Click"
                    Style="{StaticResource StopButton}"
                    Height="36" Padding="20,8" Margin="0,0,12,0"/>
            <Button x:Name="UpdateButton" Content="Update"
                    Click="UpdateButton_Click"
                    Style="{StaticResource PlayButton}"
                    Height="36" Padding="24,8"/>
        </StackPanel>
    </StackPanel>
</UserControl>
