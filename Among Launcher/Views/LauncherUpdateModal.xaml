<UserControl x:Class="AmongLauncher.Views.LauncherUpdateModal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="240" d:DesignWidth="460">
    <StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
            <Border Background="#22222A" CornerRadius="10" Width="44" Height="44"
                    HorizontalAlignment="Left" VerticalAlignment="Top">
                <TextBlock Text="⬆" FontSize="22" Foreground="#22C55E"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="Update Available" FontSize="15" FontWeight="SemiBold"
                           Foreground="{StaticResource TextTitle}"/>
                <TextBlock Text="Among Launcher" FontSize="12"
                           Foreground="{StaticResource TextMuted}"/>
            </StackPanel>
        </StackPanel>

        <TextBlock x:Name="MessageText" Text="" FontSize="14"
                   Foreground="{StaticResource TextBody}" TextWrapping="Wrap" Margin="0,0,0,24"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="CloseButton" Content="Close"
                    Click="CloseButton_Click"
                    Style="{StaticResource StopButton}"
                    Height="36" Padding="20,8" Margin="0,0,12,0"/>
            <Button x:Name="UpdateButton" Content="Update"
                    Click="UpdateButton_Click"
                    Background="#22C55E" Foreground="White" FontWeight="SemiBold"
                    BorderThickness="0" Cursor="Hand" HorizontalContentAlignment="Center"
                    Height="36" Padding="24,8"/>
        </StackPanel>
    </StackPanel>
</UserControl>
