<UserControl x:Class="AmongLauncher.Views.InGameView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignHeight="680" d:DesignWidth="560">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title -->
            <TextBlock Grid.Row="0" Text="In Game" Style="{StaticResource PageTitle}"/>

            <!-- Join lobby card -->
            <Border Grid.Row="1" Style="{StaticResource GlassCard}">
                <StackPanel>
                    <TextBlock Text="JOIN LOBBY" Style="{StaticResource CardHeader}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="LobbyCodeTextBox" Grid.Column="0"
                                 Style="{StaticResource GlassInput}"
                                 CharacterCasing="Upper" MaxLength="8"
                                 VerticalAlignment="Center" Margin="0,0,12,0"
                                 KeyDown="LobbyCodeTextBox_KeyDown"/>
                        <Button x:Name="JoinButton" Grid.Column="1" Content="JOIN"
                                Style="{StaticResource PlayButton}"
                                Click="JoinButton_Click" VerticalAlignment="Center"/>
                    </Grid>
                    <TextBlock Text="6-letter code, e.g. ABCDEF"
                               Foreground="{StaticResource TextMuted}" FontSize="12"
                               Margin="0,8,0,0"/>
                    <TextBlock x:Name="JoinErrorText"
                               Foreground="Red" FontSize="13"
                               Margin="0,8,0,0" TextWrapping="Wrap"
                               Visibility="Collapsed"/>
                    <TextBlock x:Name="JoinStatusText"
                               Foreground="{StaticResource TextMuted}" FontSize="13"
                               Margin="0,8,0,0" TextWrapping="Wrap"
                               Visibility="Collapsed"/>
                </StackPanel>
            </Border>

            <!-- Players card -->
            <Border Grid.Row="2" Style="{StaticResource GlassCard}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="PlayersHeaderText" Text="PLAYERS" Style="{StaticResource CardHeader}"/>
                    <Grid Grid.Row="1">
                        <ListBox x:Name="PlayersList"
                                 Background="Transparent" BorderThickness="0"
                                 Foreground="{StaticResource TextBody}"
                                 MaxHeight="260"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ItemContainerStyle="{StaticResource PlayerListItemStyle}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource GlassSurfaceWeak}"
                                            CornerRadius="8" Padding="14,10" Margin="0,0,0,4">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14"
                                                       Foreground="{StaticResource TextBody}"/>
                                            <TextBlock Text="{Binding Detail}"
                                                       Foreground="{StaticResource TextMuted}" FontSize="12"
                                                       Margin="0,2,0,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <Trigger Property="Text" Value="">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock x:Name="PlayersEmptyText" Text="No players yet"
                                   Foreground="{StaticResource TextMuted}" FontSize="13"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Margin="0,12"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- Mods card -->
            <Border Grid.Row="3" Style="{StaticResource GlassCard}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="ModsHeaderText" Text="MODS" Style="{StaticResource CardHeader}"/>
                    <Grid Grid.Row="1">
                        <ListBox x:Name="ModsList"
                                 Background="Transparent" BorderThickness="0"
                                 Foreground="{StaticResource TextBody}"
                                 MaxHeight="200"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ItemContainerStyle="{StaticResource PlayerListItemStyle}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource GlassSurfaceWeak}"
                                            CornerRadius="8" Padding="14,10" Margin="0,0,0,4">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14"
                                                       Foreground="{StaticResource TextBody}"/>
                                            <TextBlock Text="{Binding Detail}"
                                                       Foreground="{StaticResource TextMuted}" FontSize="12"
                                                       Margin="0,2,0,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <Trigger Property="Text" Value="">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock x:Name="ModsEmptyText" Text="No mods installed — vanilla"
                                   Foreground="{StaticResource TextMuted}" FontSize="13"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Margin="0,12"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
