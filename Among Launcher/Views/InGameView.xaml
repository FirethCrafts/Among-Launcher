<UserControl x:Class="AmongLauncher.Views.InGameView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignHeight="800" d:DesignWidth="1000">
    <Grid Margin="40">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- Title -->
        <TextBlock Text="In Game" FontSize="32" FontWeight="Bold" Foreground="White" Margin="0,0,0,24"/>
        
        <!-- Join lobby section -->
        <Border Grid.Row="1" Background="#18181B" BorderBrush="#2EFFFFFF" BorderThickness="1"
                CornerRadius="16" Padding="24" Margin="0,0,0,24">
            <StackPanel>
                <TextBlock Text="Join a Lobby" FontSize="18" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,16"/>
                <StackPanel Orientation="Horizontal">
                    <TextBox x:Name="LobbyCodeTextBox" Width="200" FontSize="16" Padding="10,8"
                             Foreground="White" Background="#222226" BorderBrush="#3F3F46"
                             CharacterCasing="Upper" MaxLength="6"/>
                    <Button x:Name="JoinButton" Content="Join" Margin="12,0,0,0" Padding="24,10"
                            Background="#5865F2" Foreground="White" FontWeight="SemiBold"
                            Click="JoinButton_Click" Cursor="Hand"/>
                </StackPanel>
            </StackPanel>
        </Border>
        
        <!-- Players section -->
        <Border Grid.Row="2" Background="#18181B" BorderBrush="#2EFFFFFF" BorderThickness="1"
                CornerRadius="16" Padding="24" Margin="0,0,0,24">
            <StackPanel>
                <TextBlock Text="Players in Lobby" FontSize="18" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,16"/>
                <ListBox x:Name="PlayersList" Background="Transparent" BorderThickness="0"
                         Foreground="White" MaxHeight="300">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="0,4">
                                <TextBlock Text="{Binding}" Foreground="#A1A1AA" FontSize="14"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>
        </Border>
        
        <!-- Mods section -->
        <Border Grid.Row="3" Background="#18181B" BorderBrush="#2EFFFFFF" BorderThickness="1"
                CornerRadius="16" Padding="24">
            <StackPanel>
                <TextBlock Text="Your Mods" FontSize="18" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,16"/>
                <ListBox x:Name="ModsList" Background="Transparent" BorderThickness="0"
                         Foreground="White" MaxHeight="300">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="0,4">
                                <TextBlock Text="{Binding}" Foreground="#A1A1AA" FontSize="14"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
