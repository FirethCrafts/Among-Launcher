<UserControl x:Class="AmongLauncher.Views.ChangelogModal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="400" d:DesignWidth="480">
    <StackPanel>
        <Border Background="{StaticResource GlassSurfaceWeak}" CornerRadius="8" Padding="16" Margin="0,0,0,16">
            <TextBlock x:Name="VersionText" FontSize="13" Foreground="{StaticResource TextBody}"
                       TextWrapping="Wrap" Text="You're now running a newer version!"/>
        </Border>

        <Border Background="{StaticResource GlassSurfaceWeak}" CornerRadius="8">
            <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto" Padding="16">
                <TextBlock x:Name="ChangelogContent" FontSize="13"
                           Foreground="{StaticResource TextBody}" TextWrapping="Wrap"
                           LineHeight="22" FontFamily="Segoe UI"/>
            </ScrollViewer>
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="UpdateButton" Content="Update AmongAPI"
                    Click="UpdateButton_Click"
                    Background="#5865F2" Foreground="White" FontWeight="SemiBold"
                    BorderThickness="0" Cursor="Hand" HorizontalContentAlignment="Center"
                    Height="36" Padding="20,8"
                    Visibility="Collapsed"/>
            <Button x:Name="CloseButton" Content="Got it"
                    Click="CloseButton_Click"
                    Style="{StaticResource SecondaryButton}"
                    Height="36" Padding="20,8" Margin="8,0,0,0"/>
        </StackPanel>
    </StackPanel>
</UserControl>
