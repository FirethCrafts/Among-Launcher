<UserControl x:Class="AmongLauncher.Views.MainView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="560" d:DesignWidth="680">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Hero Header Section -->
        <Grid Grid.Row="0" Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Game Cover Image -->
            <Border Grid.Column="0" Width="140" Height="210" CornerRadius="12"
                    Background="{StaticResource GlassSurfaceWeak}" BorderBrush="{StaticResource GlassBorder}" BorderThickness="1"
                    Margin="0,0,24,0">
                <Border.Effect>
                    <DropShadowEffect Color="#5865F2" Opacity="0.35" BlurRadius="22" ShadowDepth="4" Direction="270"/>
                </Border.Effect>
                <Grid>
                    <!-- Dark placeholder while loading -->
                    <Rectangle Fill="{StaticResource GlassSurfaceWeak}"/>
                    <!-- Remote cover image -->
                    <Image Source="https://cdn.cloudflare.steamstatic.com/steam/apps/945360/library_600x900.jpg"
                           Stretch="UniformToFill"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                </Grid>
            </Border>

            <!-- Title and Action Bar -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="Among Us" FontSize="28" FontWeight="Bold"
                           Foreground="{StaticResource TextTitle}" Margin="0,0,0,12"/>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="PlayButton" Content="PLAY"
                            Click="PlayButton_Click"
                            Style="{StaticResource PlayButton}"
                            Margin="0,0,12,0" IsEnabled="False"/>
                    <Button x:Name="InstallButton" Content="INSTALL BEPINEX"
                            Click="InstallButton_Click"
                            Style="{StaticResource SecondaryButton}"
                            Margin="0,0,12,0"/>
                    <Button x:Name="BrowseFilesButton" Content="BROWSE FILES"
                            Click="BrowseFilesButton_Click"
                            Style="{StaticResource SecondaryButton}"
                            Margin="0,0,12,0"/>
                    <Button x:Name="LogsButton" Content="LOGS"
                            Click="LogsButton_Click"
                            Style="{StaticResource SecondaryButton}"/>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- Launch Options Card -->
        <Border Grid.Row="1" Style="{StaticResource GlassCard}">
            <StackPanel>
                <TextBlock Text="LAUNCH OPTIONS" Style="{StaticResource CardHeader}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <CheckBox x:Name="HideConsoleCheckBox" Content="Hide BepInEx console"
                                  Foreground="{StaticResource TextBody}" Margin="0,0,0,12"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="Window Width:" Foreground="{StaticResource TextMuted}" FontSize="13"
                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox x:Name="WidthInput" Text="1280" Width="80"
                                     Style="{StaticResource GlassInput}" Padding="8,4"/>
                            <TextBlock Text="Height:" Foreground="{StaticResource TextMuted}" FontSize="13"
                                       VerticalAlignment="Center" Margin="16,0,8,0"/>
                            <TextBox x:Name="HeightInput" Text="720" Width="80"
                                     Style="{StaticResource GlassInput}" Padding="8,4"/>
                        </StackPanel>
                    </StackPanel>
                    <Button Grid.Column="1" Content="SAVE"
                            Click="SaveLaunchOptions_Click"
                            Style="{StaticResource SaveButton}"
                            VerticalAlignment="Bottom"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- LOCAL MODS Card -->
        <Border Grid.Row="2" Style="{StaticResource GlassCard}">
            <StackPanel>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="LOCAL MODS" Style="{StaticResource CardHeader}" Margin="0"/>
                    <Button x:Name="AddModButton" Grid.Column="1" Content="+ Add Mod"
                            Click="AddModButton_Click"
                            Style="{StaticResource SecondaryButton}"
                            Height="28" Padding="12,4" FontSize="12"/>
                </Grid>

                <!-- Add Mod Menu (Popup) -->
                <Popup x:Name="AddModPopup" PlacementTarget="{Binding ElementName=AddModButton}"
                       Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
                    <Border Background="{StaticResource GlassSurfaceWeak}" BorderBrush="{StaticResource GlassBorder}" BorderThickness="1"
                            CornerRadius="10" Padding="8" Margin="0,4,0,0"
                            SnapsToDevicePixels="True" UseLayoutRounding="True">
                        <Border.RenderTransform>
                            <TranslateTransform/>
                        </Border.RenderTransform>
                        <Border.Effect>
                            <DropShadowEffect Color="#000000" BlurRadius="12" ShadowDepth="4" Opacity="0.5"/>
                        </Border.Effect>
                        <StackPanel>
                            <Button x:Name="ImportLocalModButton" Content="Import Local Mod (.dll)"
                                    Click="ImportLocalMod_Click"
                                    Style="{StaticResource SecondaryButton}"
                                    Height="36" HorizontalAlignment="Stretch" Margin="0,0,0,4"/>
                            <Button x:Name="InstallPresetModButton" Content="Install Preset Mod"
                                    Click="InstallPresetMod_Click"
                                    Style="{StaticResource SecondaryButton}"
                                    Height="36" HorizontalAlignment="Stretch"/>
                        </StackPanel>
                    </Border>
                </Popup>

                <!-- Mods List -->
                <ItemsControl x:Name="ModsList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource GlassSurfaceWeak}" BorderBrush="{StaticResource GlassBorder}"
                                    BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,8"
                                    SnapsToDevicePixels="True" UseLayoutRounding="True">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="{StaticResource TextTitle}" FontSize="13"/>
                                        <TextBlock Text="{Binding Description}" Foreground="{StaticResource TextBody}" FontSize="11" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="Remove"
                                            Click="RemoveMod_Click"
                                            Style="{StaticResource SecondaryButton}"
                                            Foreground="{StaticResource AccentBrush}"
                                            Height="24" Padding="12,4" FontSize="11"
                                            VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- Mods & Status Card -->
        <Border Grid.Row="3" Style="{StaticResource GlassCard}">
            <StackPanel>
                <TextBlock Text="MODS &amp; STATUS" Style="{StaticResource CardHeader}"/>
                <TextBlock x:Name="GameStatusText" Text="Checking for Among Us installation..."
                           Foreground="{StaticResource TextBody}" TextWrapping="Wrap" FontSize="14" Margin="0,0,0,12"/>
                <TextBlock x:Name="ModStatusText" Text="No mod loaded"
                           Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" FontSize="13"/>
            </StackPanel>
        </Border>

        <!-- Progress -->
        <StackPanel Grid.Row="4" Margin="0,0,0,8" VerticalAlignment="Top">
            <ProgressBar x:Name="MainProgressBar" Height="8"
                         Visibility="Collapsed" IsIndeterminate="True"
                         Foreground="#5865F2" Background="{StaticResource GlassSurfaceWeak}"/>
            <TextBlock x:Name="ProgressText" Text=""
                       Foreground="{StaticResource TextMuted}"
                       Margin="0,8,0,0" Visibility="Collapsed"/>
        </StackPanel>
    </Grid>
    </ScrollViewer>
</UserControl>
