<UserControl x:Class="AmongLauncher.Views.JoinDebugModal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="400" d:DesignWidth="450">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer x:Name="LogScrollViewer" Grid.Row="0"
                      VerticalScrollBarVisibility="Auto" MaxHeight="360">
            <TextBlock x:Name="StatusTextBlock" Text=""
                       FontSize="13" Foreground="{StaticResource TextBody}"
                       FontFamily="Consolas" TextWrapping="Wrap" LineHeight="22"/>
        </ScrollViewer>

        <Button x:Name="PlayButton" Content="PLAY" Visibility="Collapsed"
                Click="PlayButton_Click"
                Height="40" Padding="30,8" FontSize="16" FontWeight="Bold"
                HorizontalAlignment="Right" Margin="0,12,0,0"
                Background="#10B981" Foreground="White" BorderThickness="0"
                Cursor="Hand"/>
    </Grid>
</UserControl>
