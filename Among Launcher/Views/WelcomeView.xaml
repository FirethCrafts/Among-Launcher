<UserControl x:Class="AmongLauncher.Views.WelcomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             UseLayoutRounding="True" SnapsToDevicePixels="True"
             d:DesignHeight="560" d:DesignWidth="880">
    <Grid UseLayoutRounding="True" SnapsToDevicePixels="True">
        <!-- Ambient radial glow: strong accent center fading to transparent at the edges -->
        <Ellipse Width="620" Height="460" VerticalAlignment="Center" HorizontalAlignment="Center"
                 UseLayoutRounding="True" SnapsToDevicePixels="True">
            <Ellipse.Fill>
                <RadialGradientBrush Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                    <GradientStop Color="#665865F2" Offset="0" />
                    <GradientStop Color="#665865F2" Offset="0.45" />
                    <GradientStop Color="#005865F2" Offset="1" />
                </RadialGradientBrush>
            </Ellipse.Fill>
            <Ellipse.Opacity>0.32</Ellipse.Opacity>
        </Ellipse>

        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="420">
            <TextBlock Text="Among Launcher"
                       FontSize="46" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"
                       HorizontalAlignment="Center" UseLayoutRounding="True" SnapsToDevicePixels="True">
                <TextBlock.Effect>
                    <DropShadowEffect Color="#6366f1" BlurRadius="14" ShadowDepth="0" Opacity="0.35"/>
                </TextBlock.Effect>
            </TextBlock>
            <TextBlock Text="Your modded Among Us, managed."
                       FontSize="17" Foreground="{StaticResource TextSecondary}"
                       Margin="0,12,0,0" HorizontalAlignment="Center"/>

            <Button Click="DiscordLogin_Click"
                    Style="{StaticResource DiscordButton}"
                    Height="48" Margin="0,32,0,0"
                    HorizontalAlignment="Stretch"/>
        </StackPanel>
    </Grid>
</UserControl>
