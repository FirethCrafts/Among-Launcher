<UserControl x:Class="AmongLauncher.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="560" d:DesignWidth="680">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Settings" Style="{StaticResource PageTitle}"/>

        <!-- Game Path -->
        <Border Grid.Row="1" Style="{StaticResource GlassCard}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="AMONG US PATH" Style="{StaticResource CardHeader}"/>
                    <ComboBox x:Name="StorefrontCombo" Style="{StaticResource GlassCombo}"
                              SelectionChanged="StorefrontCombo_SelectionChanged"
                              Margin="0,4,0,8" Width="200" HorizontalAlignment="Left"/>
                    <TextBlock x:Name="GamePathText" Text="Auto-detecting..."
                               TextTrimming="CharacterEllipsis" FontSize="13"
                               Foreground="{StaticResource TextMuted}"/>
                    <TextBlock x:Name="StorefrontStatusText" Text="" FontSize="11"
                               Foreground="{StaticResource TextMuted}" Margin="0,4,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" Click="BrowseGamePath_Click"
                        Style="{StaticResource IconButton}" ToolTip="Browse">
                    <Path Data="{StaticResource FolderIcon}" Fill="White"
                          Stretch="Uniform" Width="22" Height="22"/>
                </Button>
            </Grid>
        </Border>

        <!-- Server URL -->
        <Border Grid.Row="2" Style="{StaticResource GlassCard}">
            <StackPanel>
                <TextBlock Text="SERVER URL" Style="{StaticResource CardHeader}"/>
                <TextBox x:Name="ServerUrlTextBox"
                         Text="https://yourserver.com/api"
                         Style="{StaticResource GlassInput}"/>
            </StackPanel>
        </Border>

        <!-- Modded Install Path -->
        <Border Grid.Row="3" Style="{StaticResource GlassCard}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="MODDED INSTALL PATH" Style="{StaticResource CardHeader}"/>
                    <TextBlock x:Name="InstallPathText"
                               Text="%LocalAppData%\AmongLauncher\ModdedAmongUs"
                               TextTrimming="CharacterEllipsis" FontSize="13"
                               Foreground="{StaticResource TextMuted}"/>
                </StackPanel>
                <Button Grid.Column="1" Click="ResetInstall_Click"
                        Style="{StaticResource IconButton}" ToolTip="Reset">
                    <Path Data="{StaticResource TrashIcon}" Fill="#F87171"
                          Stretch="Uniform" Width="22" Height="22"/>
                </Button>
            </Grid>
        </Border>
    </Grid>
</UserControl>
